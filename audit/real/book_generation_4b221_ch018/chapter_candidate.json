            "SRC007787",
            "SRC005422",
            "SRC005494",
            "SRC005594"
          ],
          "idea_refs": [
            "IDEA272"
          ],
          "example_refs": [],
          "reference_refs": [
            "REF041"
          ],
          "uncertainty_refs": [],
          "paragraph_id": "P000004",
          "provider_handle": "p4"
        }
      ],
      "idea_refs": [
        "IDEA269",
        "IDEA270",
        "IDEA271",
        "IDEA272"
      ],
