        "ambiguous": true
      },
      {
        "id": "u04",
        "start_offset": 294,
        "end_offset": 357,
        "text": "which means that every believer is guaranteed a fearless death.",
        "boundary_type": "IMPLICATIVE_CONNECTIVE",
