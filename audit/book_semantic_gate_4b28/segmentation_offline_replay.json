    "units": [
      {
        "id": "u00",
        "start_offset": 0,
        "end_offset": 68,
        "text": "Yet we can see fear operating in believers, and this is not normal. ",
        "boundary_type": "SENTENCE",
        "ambiguous": false
      },
      {
        "id": "u01",
        "start_offset": 68,
        "end_offset": 94,
        "text": "Fear of death is an abuse ",
        "boundary_type": "SENTENCE",
        "ambiguous": false
      },
      {
        "id": "u02",
        "start_offset": 94,
        "end_offset": 181,
        "text": "— an abuse to your very person, a diminishment of what you were made and remade to be. ",
        "boundary_type": "EM_DASH",
        "ambiguous": false
      },
      {
        "id": "u03",
        "start_offset": 181,
        "end_offset": 229,
        "text": "It is worth naming where this abuse comes from. ",
        "boundary_type": "SENTENCE",
        "ambiguous": false
      },
      {
        "id": "u04",
        "start_offset": 229,
        "end_offset": 272,
        "text": "The devil has used it since the beginning; ",
        "boundary_type": "SENTENCE",
        "ambiguous": false
      },
      {
        "id": "u05",
        "start_offset": 272,
        "end_offset": 302,
        "text": "he has not changed his style. ",
        "boundary_type": "SEMICOLON",
        "ambiguous": false
      },
      {
        "id": "u06",
        "start_offset": 302,
        "end_offset": 406,
        "text": "The same old strategy that first weaponized death against humanity is still being run today, unchanged, ",
        "boundary_type": "SENTENCE",
        "ambiguous": true
      },
      {
        "id": "u07",
        "start_offset": 406,
        "end_offset": 466,
        "text": "because it still works wherever it is not resisted by truth.",
        "boundary_type": "CAUSAL_CONNECTIVE",
        "ambiguous": false
      }
    ],
