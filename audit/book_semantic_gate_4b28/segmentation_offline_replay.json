    "units": [
      {
        "id": "u00",
        "start_offset": 0,
        "end_offset": 46,
        "text": "But this is not a matter of mental technique. ",
        "boundary_type": "SENTENCE",
        "ambiguous": false
      },
      {
        "id": "u01",
        "start_offset": 46,
        "end_offset": 141,
        "text": "It is not mind over matter, not a trick of positive thinking applied to a frightening subject. ",
        "boundary_type": "SENTENCE",
        "ambiguous": false
      },
      {
        "id": "u02",
        "start_offset": 141,
        "end_offset": 180,
        "text": "Death as gain must become your reality ",
        "boundary_type": "SENTENCE",
        "ambiguous": false
      },
      {
        "id": "u03",
        "start_offset": 180,
        "end_offset": 294,
        "text": "— not an idea you agree with in a sermon and set aside, but the actual substance of how you face your own ending, ",
